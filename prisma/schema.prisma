generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id         String   @id @default(cuid())
  name       String
  mobile     String   @unique
  email      String?  @unique
  passwordHash String
  role       String   @default("USER") // USER, ADMIN
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  sessions       Session[]
  applications   LoanApplication[]
  transactions   Transaction[]
  repayments     Repayment[]
  notifications  Notification[]
  supportTickets SupportTicket[]
  auditLogs      AuditLog[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
}

model LoanPlan {
  id              String   @id @default(cuid())
  name            String
  amount          Float
  interest        Float
  totalRepayable  Float
  installmentCount Int
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  applications LoanApplication[]
}

model LoanApplication {
  id              String   @id @default(cuid())
  userId          String
  planId          String?
  status          String   @default("PENDING") // PENDING, VERIFYING, APPROVED, REJECTED, COMPLETED
  amount          Float
  interest        Float
  totalRepayable  Float
  installmentCount Int      @default(1)
 nidNumber       String?
  nidDocumentPath String?
  rejectionReason String?
  reviewedBy      String?
  reviewedAt      DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user        User          @relation(fields: [userId], references: [id])
  plan        LoanPlan?     @relation(fields: [planId], references: [id])
  transactions Transaction[]
  repayments   Repayment[]

  @@index([userId])
  @@index([status])
}

model Transaction {
  id            String   @id @default(cuid())
  userId        String
  applicationId String?
  type          String   // DISBURSEMENT, REPAYMENT, PAYMENT_RECEIVED
  amount        Float
  description   String?
  createdAt     DateTime @default(now())

  user        User             @relation(fields: [userId], references: [id])
  application LoanApplication? @relation(fields: [applicationId], references: [id])

  @@index([userId])
  @@index([applicationId])
}

model Repayment {
  id             String    @id @default(cuid())
  userId         String
  applicationId  String
  amount         Float
  installmentNumber Int
  dueDate        DateTime
  paidDate       DateTime?
  status         String    @default("PENDING") // PENDING, PAID, OVERDUE
  createdAt      DateTime  @default(now())

  user        User             @relation(fields: [userId], references: [id])
  application LoanApplication? @relation(fields: [applicationId], references: [id])

  @@index([userId])
  @@index([applicationId])
  @@index([status])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model SupportTicket {
  id        String   @id @default(cuid())
  userId    String
  subject   String
  message   String
  status    String   @default("OPEN") // OPEN, IN_PROGRESS, RESOLVED, CLOSED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([status])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  details   String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([createdAt])
}
